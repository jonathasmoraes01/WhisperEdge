/* WhisperEdge — folha de estilo central (placeholders @VAR@ substituidos em theme.py) */

QWidget {
    background-color: @BG@;
    color: @TEXT@;
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 13px;
}

QLabel { background: transparent; }
QLabel[role="title"]     { font-size: 19px; font-weight: 700; }
QLabel[role="subtitle"]  { font-size: 12px; color: @MUTED@; }
QLabel[role="muted"]     { color: @MUTED@; }
QLabel[role="stat"]      { font-size: 28px; font-weight: 700; color: @ACCENT@; }
QLabel[role="fieldname"] { font-size: 13px; font-weight: 600; }
QLabel[role="fielddesc"] { font-size: 11px; color: @MUTED@; }
QLabel[role="section"]   {
    font-size: 11px; font-weight: 700; color: @MUTED@;
    letter-spacing: 1px; text-transform: uppercase;
}
QLabel[role="kbd"] {
    background: @PANEL2@;
    border: 1px solid @BORDER@;
    border-radius: 6px;
    padding: 4px 10px;
    font-family: "Consolas", monospace;
    font-size: 12px;
    color: @TEXT@;
}

QToolTip {
    background-color: @PANEL2@;
    color: @TEXT@;
    border: 1px solid @BORDER@;
    padding: 6px 8px;
    border-radius: 6px;
}

/* Cartoes */
QFrame[role="card"] {
    background-color: @PANEL@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
}
QFrame[role="hline"] {
    background: @BORDER@;
    max-height: 1px;
    border: none;
}

/* Campos de entrada */
QLineEdit, QComboBox, QSpinBox, QPlainTextEdit, QTextEdit {
    background-color: @PANEL2@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 7px 10px;
    color: @TEXT@;
    selection-background-color: @ACCENT@;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus,
QPlainTextEdit:focus, QTextEdit:focus { border: 1px solid @ACCENT@; }
QLineEdit:hover, QComboBox:hover, QSpinBox:hover { border: 1px solid @MUTED@; }
QLineEdit[echoMode="2"] { letter-spacing: 2px; }

QComboBox::drop-down { border: none; width: 26px; }
QComboBox::down-arrow { image: none; width: 0; height: 0; }
QComboBox QAbstractItemView {
    background-color: @PANEL2@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    selection-background-color: @ACCENT@;
    selection-color: #ffffff;
    outline: none;
    padding: 4px;
}
QSpinBox::up-button, QSpinBox::down-button { width: 18px; border: none; background: transparent; }

/* Botoes */
QPushButton {
    background-color: @PANEL2@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 8px 18px;
    color: @TEXT@;
    font-weight: 600;
}
QPushButton:hover { border: 1px solid @ACCENT@; color: @TEXT@; }
QPushButton:pressed { background-color: @PANEL@; }
QPushButton:disabled { color: @MUTED@; }
QPushButton[role="primary"] {
    background-color: @ACCENT@;
    border: 1px solid @ACCENT@;
    color: #ffffff;
}
QPushButton[role="primary"]:hover { background-color: @ACCENT_HOVER@; border-color: @ACCENT_HOVER@; }
QPushButton[role="danger"] { color: #ff7676; }
QPushButton[role="danger"]:hover { border-color: #ff7676; }
QPushButton[role="ghost"] { background: transparent; border: none; color: @MUTED@; }
QPushButton[role="ghost"]:hover { color: @TEXT@; }

/* Checkbox (fallback; a UI usa o Switch custom) */
QCheckBox { spacing: 8px; background: transparent; }
QCheckBox::indicator {
    width: 18px; height: 18px;
    border-radius: 5px;
    border: 1px solid @BORDER@;
    background: @PANEL2@;
}
QCheckBox::indicator:checked { background: @ACCENT@; border-color: @ACCENT@; }

/* Scroll */
QScrollArea { border: none; background: transparent; }
QScrollArea > QWidget > QWidget { background: transparent; }
QScrollBar:vertical { background: transparent; width: 8px; margin: 2px; }
QScrollBar::handle:vertical { background: @BORDER@; border-radius: 4px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: @MUTED@; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QScrollBar:horizontal { height: 8px; background: transparent; }
QScrollBar::handle:horizontal { background: @BORDER@; border-radius: 4px; }

/* Listas / tabelas */
QListWidget, QTableWidget {
    background-color: @PANEL@;
    border: 1px solid @BORDER@;
    border-radius: 10px;
    outline: none;
}
QListWidget::item { padding: 10px; border-radius: 8px; margin: 2px 4px; }
QListWidget::item:selected { background: @PANEL2@; color: @TEXT@; }
QListWidget::item:hover:!selected { background: @PANEL2@; }
QTableWidget { gridline-color: @BORDER@; }
QTableWidget::item { padding: 6px; }
QTableWidget::item:selected { background: @ACCENT@; color: #ffffff; }
QHeaderView::section {
    background: transparent; color: @MUTED@; border: none;
    border-bottom: 1px solid @BORDER@; padding: 8px 6px;
    font-weight: 600; font-size: 12px;
}
QTableCornerButton::section { background: transparent; border: none; }

/* Navegacao lateral das Configuracoes */
QListWidget#nav {
    background: transparent;
    border: none;
    outline: none;
    font-size: 13px;
    font-weight: 600;
}
QListWidget#nav::item {
    padding: 10px 14px;
    border-radius: 8px;
    color: @MUTED@;
    margin: 1px 4px;
    border-left: 3px solid transparent;
}
QListWidget#nav::item:selected {
    background: @PANEL@;
    color: @TEXT@;
    border-left: 3px solid @ACCENT@;
}
QListWidget#nav::item:hover:!selected { color: @TEXT@; background: transparent; }
